{
    "TargetServer": "http://desktop-0l2beto:8080/PWBIReports",
    "TargetFolderPath": "/Reports/PowerBI",
    "FolderPath": "E:\\PWBI",
    "Overwrite": true,
    "DataSources": [
        {
            "Comment": "Only for PWBIv1.pbix - uses Order-based matching",
            "Reports": [
                "PWBIv1.pbix",
                "PWBIv1.Report.pbix"
            ],
            "Order": 1,
            "ConnectionString": "74.225.218.29,14033;IdAccess",
            "Username": "IdAccess",
            "Password": "IdAccess",
            "CredentialType": "SQL"
        },
        {
            "Comment": "Only for Sales.pbix and PWBIv1.pbix - second datasource",
            "Reports": [
                "Sales.pbix",
                "Sales.Report.pbix",
                "PWBIv1.pbix",
                "PWBIv1.Report.pbix"
            ],
            "Order": 2,
            "ConnectionString": "desktop-0l2beto;PWBI",
            "CredentialType": "Windows"
        }
    ],
    "Permissions": [
        {
            "Comment": "Only Sales.pbix gets SalesTeam access",
            "Reports": [
                "Sales.pbix",
                "Sales.Report.pbix"
            ],
            "Principal": "DESKTOP-0L2BETO\\Admin",
            "Role": [
                "Publisher",
                "Report Builder"
            ]
        }
    ],
    "Parameters": [
        {
            "Comment": "Global parameter - applies to all reports",
            "Name": "Environment",
            "Value": "Production"
        },
        {
            "Comment": "Only for Sales",
            "Reports": [
                "Sales.pbix",
                "Sales.Report.pbix"
            ],
            "Name": "ServerName",
            "Value": "DESKTOP-0L2BETO"
        },
        {
            "Comment": "Only for Sales",
            "Reports": [
                "Sales.pbix",
                "Sales.Report.pbix"
            ],
            "Name": "Databse",
            "Value": "PWBI"
        },
        {
            "Comment": "Only for PWBIv1",
            "Reports": [
                "PWBIv1.pbix",
                "PWBIv1.Report.pbix"
            ],
            "Name": "ServerName",
            "Value": "DESKTOP-0L2BETO"
        },
        {
            "Comment": "Only for PWBIv1",
            "Reports": [
                "PWBIv1.pbix",
                "PWBIv1.Report.pbix"
            ],
            "Name": "Databse",
            "Value": "PWBI"
        }
    ],
    "ReportMappings": [
        {
            "Comment": "Sales reports go to Sales folder with specific permissions",
            "SourcePattern": "Sales.*\\.pbix",
            "TargetFolderPath": "/Reports/Sales",
            "Parameters": [
                {
                    "Name": "ReportVersion",
                    "Value": "v1.0"
                }
            ]
        },
        {
            "Comment": "PWBIv1.pbix (exact) goes to specific folder",
            "SourcePattern": "^PWBIv1\\.pbix$",
            "TargetFolderPath": "/Reports/PWBI",
            "Permissions": [
                {
                    "Principal": "DESKTOP-0L2BETO\\Admin",
                    "Role": [
                        "Content Manager"
                    ]
                }
            ]
        },
        {
            "Comment": "PWBIv1.Report.pbix goes to Reports subfolder",
            "SourcePattern": "^PWBIv1\\.Report\\.pbix$",
            "TargetFolderPath": "/Reports/PWBI/Reports",
            "Permissions": [
                {
                    "Principal": "DESKTOP-0L2BETO\\Admin",
                    "Role": [
                        "Content Manager"
                    ]
                }
            ]
        }
    ]
}